      "boundElements": [],
      "updated": 1774006504206,
      "link": null,
      "locked": false,
      "text": "1. Most evident distortion \nfrom the videos.\n2. Do we need to apply any\nimage enhancement to make \nour measurements more accurate?\n3. Do we need to change the ROI\noptical flow method?",
      "fontSize": 24.942519170183672,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
